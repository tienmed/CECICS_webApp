# =====================================================================
# CẤU HÌNH MÔI TRƯỜNG — CECICS WEB APP
# Sao chép file này thành .env.local (KHÔNG commit .env.local lên GitHub)
# =====================================================================

# Chế độ chạy:
# - local: dùng file JSON cục bộ (.data/db.json), không cần cấu hình Google
# - sheets: dùng Google Sheets + Apps Script thật
DATA_MODE=local

# Cho phép đăng nhập demo chuyển nhanh các vai trò (tắt thành false khi Go-Live!)
DEMO_MODE=true

# Auth.js secret (chạy: openssl rand -base64 32)
AUTH_SECRET=thay-bang-chuoi-ngau-nhien-32-ky-tu-tro-len
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (tạo tại Google Cloud Console > Credentials > OAuth Client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Tên miền công vụ được phép đăng nhập (ngoài danh sách trắng trong tab Users)
ALLOWED_EMAIL_DOMAIN=pnt.edu.vn

# Google Sheets API v4 (Service Account chỉ cần quyền Viewer trên file Sheets)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Dán private key, giữ nguyên \n giữa các dòng
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Apps Script Web App (tầng ghi duy nhất có khóa LockService)
GAS_WEBAPP_URL=
# Khóa bí mật HMAC-SHA256 (phải khớp với Script Property "HMAC_SECRET" trên Apps Script)
GAS_HMAC_SECRET=

# Cấu hình SMTP gửi email báo cáo (Gmail / Google Workspace ĐHYK Phạm Ngọc Thạch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cecics@pnt.edu.vn
SMTP_PASS=
SMTP_FROM="Trung tâm CECICS - ĐH Y khoa Phạm Ngọc Thạch" <cecics@pnt.edu.vn>


# ---- AI Tầng 3 (trả phí, OpenAI-compatible) — chỉ dùng FAILOVER khi PNT Gemma/Qwen lỗi ----
TIER3_API_KEY=
TIER3_BASE_URL=https://api.shopaikey.com/v1
TIER3_MODEL=claude-sonnet-4-5
TIER3_FAILOVER=true
